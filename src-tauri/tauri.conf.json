{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Web Desktop",
  "version": "0.1.0",
  "identifier": "com.agegr.piweb",
  "build": {
    "frontendDist": "../.next",
    "devUrl": "http://127.0.0.1:30141",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node bin/prepare-tauri-runtime.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Web Desktop",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' http://127.0.0.1:*",
        "connect-src": "'self' http://127.0.0.1:* http://127.0.0.1:30141 ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "font-src": "'self' data: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:*",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:*",
        "frame-src": "'self' http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "resources": ["../desktop-runtime/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {}
    }
  }
}
