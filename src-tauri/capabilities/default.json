{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pi Web Desktop default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-hide",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "process:default"
  ]
}
